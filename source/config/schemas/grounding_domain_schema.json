{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grounding Domain Record",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "type": { "enum": ["new_domain", "scope_decision"] },
    "scope": { "enum": ["global", "local", "rejected", null] },
    "domain": { "type": "string" },
    "description": { "type": "string" },
    "authoritative_sources": { "type": "array", "items": { "type": "string" } },
    "machine_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "reason": { "type": "string" },
    "target_id": { "type": "string" },
    "decided_by": { "type": "string" }
  },
  "required": ["id", "type", "timestamp", "machine_id"]
}
